import numpy as np


def sigmoid(z):
    z = np.clip(z, -500, 500)
    return 1.0 / (1.0 + np.exp(-z))


def sigmoid_derivative_from_activation(a):
    """Given a = sigmoid(z), returns sigma'(z) = a * (1 - a)."""
    return a * (1.0 - a)


class NeuralNetworkBackprop:
    def __init__(self, input_size, hidden_size, output_size, learning_rate=0.5, seed=42):
        rng = np.random.default_rng(seed)
        self.lr = learning_rate

        # Weight initialization
        self.W1 = rng.normal(0.0, 1.0 / np.sqrt(input_size), size=(input_size, hidden_size))
        self.b1 = np.zeros((1, hidden_size))

        self.W2 = rng.normal(0.0, 1.0 / np.sqrt(hidden_size), size=(hidden_size, output_size))
        self.b2 = np.zeros((1, output_size))

    def forward(self, X):
        self.z1 = X @ self.W1 + self.b1
        self.a1 = sigmoid(self.z1)

        self.z2 = self.a1 @ self.W2 + self.b2
        self.a2 = sigmoid(self.z2)
        return self.a2

    def compute_loss(self, y_true, y_pred):
        n = y_true.shape[0]
        return 0.5 * np.mean(np.sum((y_true - y_pred) ** 2, axis=1))

    def backward(self, X, y_true, y_pred):
        n = X.shape[0]

        # Output layer error & gradients
        dL_da2 = (y_pred - y_true) / n
        delta2 = dL_da2 * sigmoid_derivative_from_activation(self.a2)
        dW2 = self.a1.T @ delta2
        db2 = np.sum(delta2, axis=0, keepdims=True)

        # Hidden layer error & gradients
        delta1 = (delta2 @ self.W2.T) * sigmoid_derivative_from_activation(self.a1)
        dW1 = X.T @ delta1
        db1 = np.sum(delta1, axis=0, keepdims=True)

        # Gradient descent update
        self.W2 -= self.lr * dW2
        self.b2 -= self.lr * db2
        self.W1 -= self.lr * dW1
        self.b1 -= self.lr * db1

    def train(self, X, y, epochs=5000, log_every=1000):
        history = []
        for epoch in range(1, epochs + 1):
            y_pred = self.forward(X)
            loss = self.compute_loss(y, y_pred)
            history.append(loss)
            self.backward(X, y, y_pred)

            if log_every and (epoch == 1 or epoch % log_every == 0 or epoch == epochs):
                preds_bin = (y_pred >= 0.5).astype(int)
                acc = np.mean(preds_bin == y.astype(int)) * 100.0
                print(f"Epoch {epoch:5d}/{epochs} | Loss: {loss:.6f} | Accuracy: {acc:6.2f}%")
        return history

    def predict(self, X, threshold=0.5):
        probs = self.forward(X)
        return probs, (probs >= threshold).astype(int)


