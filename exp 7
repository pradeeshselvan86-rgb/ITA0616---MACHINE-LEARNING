import numpy as np


def sigmoid(z):
    z = np.clip(z, -500, 500)
    return 1.0 / (1.0 + np.exp(-z))


class LogisticRegressionScratch:
    def __init__(self, learning_rate=0.1, epochs=2000, reg_lambda=0.0):
        self.lr = learning_rate
        self.epochs = epochs
        self.reg_lambda = reg_lambda  # Optional L2 regularization strength
        self.weights = None
        self.bias = None
        self.loss_history = []

    def fit(self, X, y):
        X = np.asarray(X, dtype=float)
        y = np.asarray(y, dtype=float).reshape(-1, 1)

        n_samples, n_features = X.shape
        self.weights = np.zeros((n_features, 1), dtype=float)
        self.bias = 0.0
        self.loss_history = []

        eps = 1e-15
        for _ in range(self.epochs):
            linear_out = X @ self.weights + self.bias
            probs = sigmoid(linear_out)

            # Binary Cross-Entropy loss + optional L2 penalty
            clipped_probs = np.clip(probs, eps, 1.0 - eps)
            bce = -np.mean(
                y * np.log(clipped_probs) + (1.0 - y) * np.log(1.0 - clipped_probs)
            )
            l2_term = (self.reg_lambda / (2.0 * n_samples)) * np.sum(self.weights ** 2)
            self.loss_history.append(float(bce + l2_term))

            # Gradients
            error = probs - y
            dw = (X.T @ error) / n_samples + (self.reg_lambda / n_samples) * self.weights
            db = float(np.mean(error))

            # Parameter updates
            self.weights -= self.lr * dw
            self.bias -= self.lr * db

        return self

    def predict_proba(self, X):
        X = np.asarray(X, dtype=float)
        return sigmoid(X @ self.weights + self.bias).ravel()

    def predict(self, X, threshold=0.5):
        return (self.predict_proba(X) >= threshold).astype(int)


def standardize_splits(X_train, X_test):
    mean = np.mean(X_train, axis=0)
    std = np.std(X_train, axis=0)
    std = np.where(std == 0, 1.0, std)
    return (X_train - mean) / std, (X_test - mean) / std


def confusion_matrix_binary(y_true, y_pred):
    y_true = np.asarray(y_true, dtype=int)
    y_pred = np.asarray(y_pred, dtype=int)
    tn = int(np.sum((y_true == 0) & (y_pred == 0)))
    fp = int(np.sum((y_true == 0) & (y_pred == 1)))
    fn = int(np.sum((y_true == 1) & (y_pred == 0)))
    tp = int(np.sum((y_true == 1) & (y_pred == 1)))
    return np.array([[tn, fp], [fn, tp]])


if __name__ == "__main__":
    # Create a reproducible binary classification dataset with 3 features
    rng = np.random.default_rng(42)
    n_per_class = 80

    X0 = rng.normal(loc=[-1.5, 1.0, 20.0], scale=[1.0, 1.1, 5.0], size=(n_per_class, 3))
    y0 = np.zeros(n_per_class, dtype=int)

    X1 = rng.normal(loc=[1.8, -1.2, 35.0], scale=[1.0, 1.0, 6.0], size=(n_per_class, 3))
    y1 = np.ones(n_per_class, dtype=int)

    X = np.vstack([X0, X1])
    y = np.concatenate([y0, y1])

    # Shuffle and split 80% train / 20% test
    perm = rng.permutation(len(X))
    X, y = X[perm], y[perm]

    split = int(0.8 * len(X))
    X_train_raw, X_test_raw = X[:split], X[split:]
    y_train, y_test = y[:split], y[split:]

    X_train, X_test = standardize_splits(X_train_raw, X_test_raw)

    model = LogisticRegressionScratch(learning_rate=0.2, epochs=1500, reg_lambda=0.01)
    model.fit(X_train, y_train)

    y_pred = model.predict(X_test)
    probs_test = model.predict_proba(X_test)
    cm = confusion_matrix_binary(y_test, y_pred)
    acc = np.mean(y_pred == y_test) * 100.0

    print(f"Initial Loss: {model.loss_history[0]:.4f} -> Final Loss: {model.loss_history[-1]:.4f}")
    print(f"Learned Weights: {model.weights.ravel().round(4)} | Bias: {model.bias:.4f}")
    print(f"Test Accuracy: {acc:.2f}% ({np.sum(y_pred == y_test)}/{len(y_test)})\n")
    print("Confusion Matrix (Rows = Actual [0, 1], Cols = Predicted [0, 1]):")
    print(cm)

    print("\nSample Test Predictions:")
    for i in range(5):
        print(f"  Test #{i+1}: Actual={y_test[i]}, Prob={probs_test[i]:.4f}, Pred={y_pred[i]}")


