import numpy as np
import pandas as pd
from sklearn.base import BaseEstimator, ClassifierMixin
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    precision_recall_fscore_support,
)
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import CategoricalNB, GaussianNB
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, OrdinalEncoder


def create_sample_loan_dataset(n_samples=700, seed=42):
    """
    Generate a realistic bank loan approval dataset with numerical and categorical features
    and binary target 'Loan_Status' ('Approved' / 'Rejected').
    """
    rng = np.random.default_rng(seed)

    applicant_income = rng.normal(62000.0, 26000.0, size=n_samples).clip(18000.0, 220000.0)
    coapplicant_income = rng.choice(
        [0.0, rng.normal(28000.0, 14000.0, size=1)[0]],
        size=n_samples,
        p=[0.42, 0.58],
    )
    coapplicant_income = np.where(
        coapplicant_income == 0.0,
        0.0,
        rng.normal(28000.0, 14000.0, size=n_samples).clip(5000.0, 120000.0),
    )
    loan_amount = rng.normal(155.0, 75.0, size=n_samples).clip(25.0, 600.0)  # in $k
    loan_term_months = rng.choice([120, 180, 240, 360], size=n_samples, p=[0.10, 0.15, 0.25, 0.50])
    credit_score = rng.integers(520, 830, size=n_samples)
    debt_to_income = rng.uniform(0.05, 0.65, size=n_samples)

    education = rng.choice(["Graduate", "Not Graduate"], size=n_samples, p=[0.74, 0.26])
    self_employed = rng.choice(["No", "Yes"], size=n_samples, p=[0.82, 0.18])
    married = rng.choice(["Yes", "No"], size=n_samples, p=[0.65, 0.35])
    property_area = rng.choice(["Urban", "Semiurban", "Rural"], size=n_samples, p=[0.38, 0.36, 0.26])

    total_income = applicant_income + coapplicant_income
    loan_to_income_ratio = loan_amount / (total_income / 1000.0)

    # Latent approval score combining credit history, affordability, and categorical factors
    score = (
        (credit_score - 660.0) * 0.032
        + np.log1p(total_income / 10000.0) * 1.1
        - loan_to_income_ratio * 0.85
        - (debt_to_income - 0.30) * 4.5
        + np.where(education == "Graduate", 0.35, -0.20)
        + np.where(property_area == "Semiurban", 0.30, np.where(property_area == "Urban", 0.15, 0.0))
        - np.where(self_employed == "Yes", 0.20, 0.0)
        + rng.normal(0.0, 0.75, size=n_samples)
    )

    prob_approve = 1.0 / (1.0 + np.exp(-score))
    loan_status = np.where(rng.random(size=n_samples) < prob_approve, "Approved", "Rejected")

    df = pd.DataFrame({
        "Applicant_Income": np.round(applicant_income, 2),
        "Coapplicant_Income": np.round(coapplicant_income, 2),
        "Loan_Amount_K": np.round(loan_amount, 2),
        "Loan_Term_Months": loan_term_months,
        "Credit_Score": credit_score,
        "Debt_to_Income": np.round(debt_to_income, 3),
        "Education": education,
        "Self_Employed": self_employed,
        "Married": married,
        "Property_Area": property_area,
        "Loan_Status": loan_status,
    })
    return df


class MixedNaiveBayesClassifier(BaseEstimator, ClassifierMixin):
    """
    Combines GaussianNB on numerical features and CategoricalNB on categorical features
    by summing log-priors and per-modality log-likelihoods.
    """

    def __init__(self, num_cols, cat_cols, var_smoothing=1e-9, alpha=1.0):
        self.num_cols = list(num_cols)
        self.cat_cols = list(cat_cols)
        self.var_smoothing = var_smoothing
        self.alpha = alpha

    def fit(self, X, y):
        X_df = pd.DataFrame(X).copy()
        y_arr = np.asarray(y)
        self.classes_ = np.unique(y_arr)
        n_samples = len(y_arr)

        # Log prior log P(y)
        self.log_priors_ = np.array([
            np.log(np.sum(y_arr == c) / n_samples) for c in self.classes_
        ])

        self.has_num_ = len(self.num_cols) > 0
        self.has_cat_ = len(self.cat_cols) > 0

        if self.has_num_:
            self.num_imputer_ = SimpleImputer(strategy="median")
            X_num = self.num_imputer_.fit_transform(X_df[self.num_cols])
            self.gnb_ = GaussianNB(var_smoothing=self.var_smoothing)
            self.gnb_.fit(X_num, y_arr)

        if self.has_cat_:
            self.cat_imputer_ = SimpleImputer(strategy="most_frequent")
            self.encoder_ = OrdinalEncoder(
                handle_unknown="use_encoded_value", unknown_value=-1
            )
            X_cat_raw = self.cat_imputer_.fit_transform(X_df[self.cat_cols])
            X_cat_enc = self.encoder_.fit_transform(X_cat_raw)

            # Shift unknown (-1) to its own bin index for CategoricalNB
            self.n_cat_bins_ = [
                len(cats) + 1 for cats in self.encoder_.categories_
            ]
            X_cat_shifted = X_cat_enc.copy()
            for col_idx in range(X_cat_shifted.shape[1]):
                unknown_mask = X_cat_shifted[:, col_idx] < 0
                X_cat_shifted[unknown_mask, col_idx] = len(self.encoder_.categories_[col_idx])

            self.cnb_ = CategoricalNB(
                alpha=self.alpha, min_categories=self.n_cat_bins_
            )
            self.cnb_.fit(X_cat_shifted, y_arr)

        return self

    def _joint_log_likelihood(self, X):
        X_df = pd.DataFrame(X).copy()
        n_samples = len(X_df)
        scores = np.tile(self.log_priors_, (n_samples, 1))

        if self.has_num_:
            X_num = self.num_imputer_.transform(X_df[self.num_cols])
            # GaussianNB.predict_joint_log_proba returns log P(y) + log P(X_num | y)
            num_jll = self.gnb_.predict_joint_log_proba(X_num)
            scores = num_jll

        if self.has_cat_:
            X_cat_raw = self.cat_imputer_.transform(X_df[self.cat_cols])
            X_cat_enc = self.encoder_.transform(X_cat_raw)
            X_cat_shifted = X_cat_enc.copy()
            for col_idx in range(X_cat_shifted.shape[1]):
                unknown_mask = X_cat_shifted[:, col_idx] < 0
                X_cat_shifted[unknown_mask, col_idx] = len(self.encoder_.categories_[col_idx])

            cat_log_lik = self.cnb_.feature_log_prob_
            # Accumulate log P(x_m | y) for each categorical column m
            cat_ll = np.zeros((n_samples, len(self.classes_)), dtype=float)
            for col_idx in range(X_cat_shifted.shape[1]):
                cat_indices = X_cat_shifted[:, col_idx].astype(int)
                # cat_log_lik[col_idx] has shape (n_classes, n_bins_for_col)
                cat_ll += cat_log_lik[col_idx][:, cat_indices].T

            if self.has_num_:
                scores = scores + cat_ll
            else:
                scores = scores + cat_ll

        return scores

    def predict_proba(self, X):
        jll = self._joint_log_likelihood(X)
        # Log-sum-exp for numerical stability
        max_jll = np.max(jll, axis=1, keepdims=True)
        log_prob = jll - max_jll - np.log(np.sum(np.exp(jll - max_jll), axis=1, keepdims=True))
        return np.exp(log_prob)

    def predict(self, X):
        jll = self._joint_log_likelihood(X)
        return self.classes_[np.argmax(jll, axis=1)]


def main():
    # To load your own CSV file instead, replace the next line with:
    # df = pd.read_csv("loan_data.csv")
    df = create_sample_loan_dataset(n_samples=700, seed=42)

    print("Dataset Shape:", df.shape)
    print("Loan Status Distribution:\n", df["Loan_Status"].value_counts(), "\n")

    target_col = "Loan_Status"
    X = df.drop(columns=[target_col])
    y = df[target_col]

    num_cols = X.select_dtypes(include=["int64", "float64"]).columns.tolist()
    cat_cols = X.select_dtypes(include=["object", "category"]).columns.tolist()

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=42, stratify=y
    )

    # 1. Mixed Naïve Bayes (GaussianNB for numeric + CategoricalNB for categorical)
    mixed_nb = MixedNaiveBayesClassifier(num_cols=num_cols, cat_cols=cat_cols, alpha=1.0)
    mixed_nb.fit(X_train, y_train)
    y_pred_mixed = mixed_nb.predict(X_test)

    acc_mixed = accuracy_score(y_test, y_pred_mixed)
    labels_order = ["Rejected", "Approved"]
    cm_mixed = confusion_matrix(y_test, y_pred_mixed, labels=labels_order)

    print("=== Mixed Naïve Bayes (GaussianNB + CategoricalNB) ===")
    print(f"Test Accuracy: {acc_mixed * 100:.2f}% ({np.sum(y_pred_mixed == y_test)}/{len(y_test)})\n")
    print("Confusion Matrix (Rows = Actual, Cols = Predicted [Rejected, Approved]):")
    print(pd.DataFrame(cm_mixed, index=labels_order, columns=labels_order), "\n")
    print("Classification Report:")
    print(classification_report(y_test, y_pred_mixed, target_names=labels_order, digits=4))

    # 2. Comparison: One-Hot Encoded + GaussianNB baseline
    preprocessor_ohe = ColumnTransformer(transformers=[
        ("num", SimpleImputer(strategy="median"), num_cols),
        ("cat", Pipeline([
            ("imputer", SimpleImputer(strategy="most_frequent")),
            ("onehot", OneHotEncoder(handle_unknown="ignore", sparse_output=False)),
        ]), cat_cols),
    ])
    ohe_gnb = Pipeline([
        ("prep", preprocessor_ohe),
        ("gnb", GaussianNB()),
    ])
    ohe_gnb.fit(X_train, y_train)
    y_pred_ohe = ohe_gnb.predict(X_test)
    print(f"One-Hot + GaussianNB Baseline Accuracy: {accuracy_score(y_test, y_pred_ohe) * 100:.2f}%\n")

    # 3. Predict Loan Status for new applicants
    new_applicants = pd.DataFrame([
        {
            "Applicant_Income": 85000.0,
            "Coapplicant_Income": 32000.0,
            "Loan_Amount_K": 160.0,
            "Loan_Term_Months": 240,
            "Credit_Score": 765,
            "Debt_to_Income": 0.18,
            "Education": "Graduate",
            "Self_Employed": "No",
            "Married": "Yes",
            "Property_Area": "Semiurban",
        },
        {
            "Applicant_Income": 26000.0,
            "Coapplicant_Income": 0.0,
            "Loan_Amount_K": 240.0,
            "Loan_Term_Months": 360,
            "Credit_Score": 565,
            "Debt_to_Income": 0.54,
            "Education": "Not Graduate",
            "Self_Employed": "Yes",
            "Married": "No",
            "Property_Area": "Rural",
        },
    ])

    applicant_preds = mixed_nb.predict(new_applicants)
    applicant_probs = mixed_nb.predict_proba(new_applicants)

    print("=== New Loan Applicant Predictions ===")
    for idx, (row, status, probs) in enumerate(
        zip(new_applicants.to_dict(orient="records"), applicant_preds, applicant_probs),
        start=1,
    ):
        prob_map = {cls: round(float(p), 4) for cls, p in zip(mixed_nb.classes_, probs)}
        print(
            f"Applicant {idx} (Income={row['Applicant_Income']}, Loan=${row['Loan_Amount_K']}k, "
            f"Credit={row['Credit_Score']}) -> {status} | Probs: {prob_map}"
        )



