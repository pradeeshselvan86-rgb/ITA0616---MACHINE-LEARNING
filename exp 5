from collections import Counter
import numpy as np


def compute_distance(x1, x2, metric="euclidean"):
    """Compute distance between two 1D feature vectors."""
    diff = x1 - x2
    if metric == "euclidean":
        return float(np.sqrt(np.sum(diff ** 2)))
    elif metric == "manhattan":
        return float(np.sum(np.abs(diff)))
    else:
        raise ValueError(f"Unsupported distance metric: {metric}")


class KNNClassifier:
    def __init__(self, k=3, metric="euclidean"):
        if k < 1:
            raise ValueError("k must be a positive integer.")
        self.k = k
        self.metric = metric
        self.X_train = None
        self.y_train = None

    def fit(self, X, y):
        """Store training data (lazy learning)."""
        self.X_train = np.asarray(X, dtype=float)
        self.y_train = np.asarray(y)
        if self.k > len(self.X_train):
            raise ValueError("k cannot be greater than the number of training samples.")
        return self

    def _predict_one(self, x):
        # Compute (distance, label) for every training point
        distances = [
            (compute_distance(x, x_i, metric=self.metric), label)
            for x_i, label in zip(self.X_train, self.y_train)
        ]
        # Sort by distance ascending
        distances.sort(key=lambda pair: pair[0])
        k_neighbors = distances[: self.k]

        # Count votes among top K neighbors
        counts = Counter(label for _, label in k_neighbors)
        max_votes = max(counts.values())
        tied_labels = [label for label, cnt in counts.items() if cnt == max_votes]

        if len(tied_labels) == 1:
            return tied_labels[0]

        # Tie-breaker: pick the label whose closest neighbor among the top K has smallest distance
        for dist, label in k_neighbors:
            if label in tied_labels:
                return label

    def predict(self, X):
        X = np.asarray(X, dtype=float)
        return np.array([self._predict_one(x) for x in X])

    def score(self, X, y):
        preds = self.predict(X)
        return float(np.mean(preds == np.asarray(y)))


def standardize_train_test(X_train, X_test):
    """Standardize features using training set statistics only."""
    mean = np.mean(X_train, axis=0)
    std = np.std(X_train, axis=0)
    std = np.where(std == 0, 1.0, std)
    return (X_train - mean) / std, (X_test - mean) / std


# ==========================================
# Demo 1: Small 2D Dataset with Neighbor Inspection
# ==========================================
print("=== Demo 1: 2D Classification (K=3, Euclidean) ===")
X_demo = np.array([
    [1.0, 2.0],
    [1.5, 1.8],
    [5.0, 8.0],
    [6.0, 9.0],
    [1.2, 0.8],
    [8.0, 8.0],
])
y_demo = np.array(["Class A", "Class A", "Class B", "Class B", "Class A", "Class B"])

knn_demo = KNNClassifier(k=3, metric="euclidean").fit(X_demo, y_demo)
test_points = np.array([[2.0, 2.0], [7.0, 8.5]])
predictions = knn_demo.predict(test_points)

for pt, pred in zip(test_points, predictions):
    dists = sorted(
        (compute_distance(pt, x_i, "euclidean"), lbl, x_i.tolist())
        for x_i, lbl in zip(X_demo, y_demo)
    )[:3]
    print(f"Query {pt.tolist()} -> Predicted: {pred} | Top 3 neighbors: {dists}")


# ==========================================
# Demo 2: Multi-Feature Train/Test Evaluation
# ==========================================
print("\n=== Demo 2: Train/Test Split Evaluation ===")
rng = np.random.default_rng(42)
n_total = 150
X_raw = rng.normal(loc=[10.0, 50.0, 2.0], scale=[3.0, 15.0, 1.0], size=(n_total, 3))
# Target rule based on standardized-like combination
score_val = (X_raw[:, 0] - 10.0) / 3.0 + (X_raw[:, 1] - 50.0) / 15.0 - 0.8 * ((X_raw[:, 2] - 2.0) / 1.0)
y_all = np.where(score_val > 0.0, "Positive", "Negative")

split = int(0.8 * n_total)
X_tr_raw, X_te_raw = X_raw[:split], X_raw[split:]
y_tr, y_te = y_all[:split], y_all[split:]

X_tr, X_te = standardize_train_test(X_tr_raw, X_te_raw)

for k in [1, 3, 5, 7]:
    clf = KNNClassifier(k=k, metric="euclidean").fit(X_tr, y_tr)
    acc = clf.score(X_te, y_te) * 100.0
    print(f"K={k:2d} -> Test Accuracy: {acc:.2f}%")


