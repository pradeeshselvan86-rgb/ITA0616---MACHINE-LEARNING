import numpy as np
import pandas as pd
from sklearn.datasets import load_iris
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler


def main():
    # 1. Load the Iris dataset
    iris = load_iris()
    X = pd.DataFrame(iris.data, columns=iris.feature_names)
    y = pd.Series(iris.target, name="species_id")
    target_names = iris.target_names  # ['setosa', 'versicolor', 'virginica']

    print("Dataset shape:", X.shape)
    print("Species:", list(target_names))
    print("\nFirst 5 rows:")
    print(pd.concat([X.head(), y.head().map(lambda i: target_names[i]).rename("species")], axis=1))

    # 2. Stratified train-test split (80% train, 20% test)
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=42, stratify=y
    )

    # 3. Compare different values of K inside a leak-free pipeline
    print("\n=== Accuracy Across K Values ===")
    best_k = 5
    best_acc = -1.0

    for k in [1, 3, 5, 7, 9]:
        pipe = Pipeline([
            ("scaler", StandardScaler()),
            ("knn", KNeighborsClassifier(n_neighbors=k, metric="euclidean")),
        ])
        pipe.fit(X_train, y_train)
        preds = pipe.predict(X_test)
        acc = accuracy_score(y_test, preds)
        print(f"K = {k:2d} -> Test Accuracy: {acc * 100:.2f}%")
        if acc > best_acc:
            best_acc = acc
            best_k = k

    # 4. Fit final model with best K and evaluate
    model = Pipeline([
        ("scaler", StandardScaler()),
        ("knn", KNeighborsClassifier(n_neighbors=best_k, metric="euclidean")),
    ])
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)

    print(f"\n=== Detailed Evaluation (K = {best_k}) ===")
    print(f"Test Accuracy: {accuracy_score(y_test, y_pred) * 100:.2f}%\n")
    print("Confusion Matrix (Rows = Actual, Cols = Predicted):")
    cm = confusion_matrix(y_test, y_pred)
    cm_df = pd.DataFrame(cm, index=target_names, columns=target_names)
    print(cm_df)

    print("\nClassification Report:")
    print(classification_report(y_test, y_pred, target_names=target_names, digits=4))

    # 5. Predict species for new flower samples
    new_samples = pd.DataFrame(
        [
            [5.1, 3.5, 1.4, 0.2],  # Typical setosa
            [6.0, 2.7, 4.2, 1.3],  # Typical versicolor
            [6.7, 3.0, 5.6, 2.2],  # Typical virginica
        ],
        columns=iris.feature_names,
    )

    sample_preds = model.predict(new_samples)
    sample_probs = model.predict_proba(new_samples)

    print("=== New Sample Predictions ===")
    for idx, row in new_samples.iterrows():
        pred_name = target_names[sample_preds[idx]]
        prob_str = ", ".join(
            f"{name}: {prob:.2f}" for name, prob in zip(target_names, sample_probs[idx])
        )
        print(f"Sample {idx + 1} {row.to_dict()} -> {pred_name} ({prob_str})")


if __name__ == "__main__":
    main()

