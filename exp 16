import time
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    f1_score,
)
from sklearn.model_selection import StratifiedKFold, cross_val_score, train_test_split
from sklearn.naive_bayes import GaussianNB
from sklearn.neighbors import KNeighborsClassifier
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC
from sklearn.tree import DecisionTreeClassifier


def make_benchmark_dataset(n_samples=600, seed=42):
    """Create a 3-class non-linear tabular dataset with informative and noisy features."""
    rng = np.random.default_rng(seed)

    x1 = rng.normal(0.0, 1.5, size=n_samples)
    x2 = rng.normal(0.0, 1.5, size=n_samples)
    x3 = rng.uniform(-2.0, 2.0, size=n_samples)
    noise_feat = rng.normal(0.0, 2.0, size=n_samples)

    # Non-linear decision rule across x1, x2, x3
    signal = (x1 ** 2) - 0.8 * (x2 ** 2) + 1.2 * x1 * x2 + 0.9 * x3 + rng.normal(0.0, 0.7, size=n_samples)

    y = np.where(signal < -1.2, 0, np.where(signal < 1.3, 1, 2))
    X = pd.DataFrame({
        "Feature_1": x1,
        "Feature_2": x2,
        "Feature_3": x3,
        "Noise_Feature": noise_feat,
    })
    return X, pd.Series(y, name="Class")


def build_models():
    """Return pipelines for each classifier (scaling applied where needed)."""
    return {
        "Logistic Regression": Pipeline([
            ("scaler", StandardScaler()),
            ("clf", LogisticRegression(max_iter=1000, random_state=42)),
        ]),
        "KNN (k=7)": Pipeline([
            ("scaler", StandardScaler()),
            ("clf", KNeighborsClassifier(n_neighbors=7)),
        ]),
        "Gaussian Naive Bayes": Pipeline([
            ("clf", GaussianNB()),
        ]),
        "Decision Tree": Pipeline([
            ("clf", DecisionTreeClassifier(max_depth=6, random_state=42)),
        ]),
        "Random Forest": Pipeline([
            ("clf", RandomForestClassifier(n_estimators=200, random_state=42, n_jobs=-1)),
        ]),
        "SVM (RBF Kernel)": Pipeline([
            ("scaler", StandardScaler()),
            ("clf", SVC(kernel="rbf", C=1.5, gamma="scale", random_state=42)),
        ]),
    }


def main():
    X, y = make_benchmark_dataset(n_samples=600, seed=42)
    class_names = ["Class_0", "Class_1", "Class_2"]

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.25, random_state=42, stratify=y
    )

    models = build_models()
    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

    results = []
    fitted_models = {}

    for name, pipe in models.items():
        cv_scores = cross_val_score(pipe, X_train, y_train, cv=cv, scoring="accuracy")

        t0 = time.perf_counter()
        pipe.fit(X_train, y_train)
        fit_ms = (time.perf_counter() - t0) * 1000.0

        t1 = time.perf_counter()
        y_pred = pipe.predict(X_test)
        pred_ms = (time.perf_counter() - t1) * 1000.0

        test_acc = accuracy_score(y_test, y_pred)
        macro_f1 = f1_score(y_test, y_pred, average="macro")

        results.append({
            "Algorithm": name,
            "CV_Mean_Acc": cv_scores.mean(),
            "CV_Std": cv_scores.std(),
            "Test_Acc": test_acc,
            "Test_Macro_F1": macro_f1,
            "Fit_ms": fit_ms,
            "Predict_ms": pred_ms,
        })
        fitted_models[name] = y_pred

    summary_df = pd.DataFrame(results).sort_values(by="Test_Macro_F1", ascending=False)
    print("=== Classification Algorithm Comparison (Sorted by Test Macro F1) ===\n")
    print(
        summary_df.to_string(
            index=False,
            formatters={
                "CV_Mean_Acc": "{:.4f}".format,
                "CV_Std": "{:.4f}".format,
                "Test_Acc": "{:.4f}".format,
                "Test_Macro_F1": "{:.4f}".format,
                "Fit_ms": "{:.2f}".format,
                "Predict_ms": "{:.2f}".format,
            },
        )
    )

    best_name = summary_df.iloc[0]["Algorithm"]
    best_preds = fitted_models[best_name]

    print(f"\n=== Detailed Test Report: {best_name} ===")
    print("Confusion Matrix (Rows = Actual, Cols = Predicted):")
    print(pd.DataFrame(confusion_matrix(y_test, best_preds), index=class_names, columns=class_names))
    print("\nClassification Report:")
    print(classification_report(y_test, best_preds, target_names=class_names, digits=4))


if __name__ == "__main__":
    main()

