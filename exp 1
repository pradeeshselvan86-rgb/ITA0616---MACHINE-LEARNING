        "import csv\n",
        "\n",
        "\n",
        "def find_s(training_data):\n",
        "    \"\"\"\n",
        "    Finds the most specific hypothesis consistent with positive training examples.\n",
        "    training_data: list of rows where the last column is the class label ('Yes' / 'No').\n",
        "    \"\"\"\n",
        "    num_attributes = len(training_data[0]) - 1\n",
        "    # Initialize most specific hypothesis: ['0', '0', ..., '0'] representing Phi\n",
        "    hypothesis = [\"0\"] * num_attributes\n",
        "\n",
        "    print(f\"Initial Hypothesis h0: {hypothesis}\\n\")\n",
        "\n",
        "    for idx, row in enumerate(training_data, start=1):\n",
        "        attributes = row[:-1]\n",
        "        label = row[-1].strip()\n",
        "\n",
        "        if label.lower() == \"yes\":\n",
        "            for i in range(num_attributes):\n",
        "                if hypothesis[i] == \"0\":\n",
        "                    hypothesis[i] = attributes[i]\n",
        "                elif hypothesis[i] != attributes[i]:\n",
        "                    hypothesis[i] = \"?\"\n",
        "            print(f\"Instance {idx} (Positive): {attributes} -> h{idx} = {hypothesis}\")\n",
        "        else:\n",
        "            print(f\"Instance {idx} (Negative): {attributes} -> Ignored, h{idx} = {hypothesis}\")\n",
        "\n",
        "    return hypothesis\n",
        "\n",
        "\n",
        "# Sample EnjoySport Dataset\n",
        "dataset = [\n",
        "    [\"Sunny\", \"Warm\", \"Normal\", \"Strong\", \"Warm\", \"Same\", \"Yes\"],\n",
        "    [\"Sunny\", \"Warm\", \"High\", \"Strong\", \"Warm\", \"Same\", \"Yes\"],\n",
        "    [\"Rainy\", \"Cold\", \"High\", \"Strong\", \"Warm\", \"Change\", \"No\"],\n",
        "    [\"Sunny\", \"Warm\", \"High\", \"Strong\", \"Cool\", \"Change\", \"Yes\"],\n",
        "]\n",
        "\n",
        "final_hypothesis = find_s(dataset)\n",
        "print(\"\\nMost Specific Hypothesis:\")\n",
        "print(final_hypothesis)"
      ]
